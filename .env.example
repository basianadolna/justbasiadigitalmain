# Sanity project (content backend + embedded /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the on-demand revalidation webhook (Vercel + Sanity webhook)
SANITY_REVALIDATE_SECRET=

# Write token used only by scripts/seed-content.mts (never commit a real value)
SANITY_WRITE_TOKEN=

# Public site URL used for canonical/OG/sitemap
NEXT_PUBLIC_SITE_URL=https://justbasiadigital.com

# Set to "true" only at launch; before launch every page is noindex
NEXT_PUBLIC_ALLOW_INDEXING=false
